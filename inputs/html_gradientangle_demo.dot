digraph HtmlGradientAngleDemo {
    label="HTML GRADIENTANGLE Demo";
    labelloc=t;

    node [shape=plain];

    gradient [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="8" CELLPADDING="8" BGCOLOR="lightblue:lightyellow" GRADIENTANGLE="45">
            <TR>
                <TD BGCOLOR="lightpink:lightcyan" GRADIENTANGLE="90">cell gradient</TD>
                <TD>plain cell</TD>
            </TR>
        </TABLE>
    >];
}
